# Copy to .env for local development (never commit .env). Values here are fictitious.
# Every variable is validated at startup by parseConfig() in src/core/config.ts.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Behind a reverse proxy / PaaS router set to true (or a hop count) so request.ip is the client.
TRUST_PROXY=false

# Comma-separated explicit origins (never * in production).
CORS_ORIGINS=http://localhost:5173

# One DSN per connection name declared in the project profile (<APP>_DB_<NAME>_DSN).
APP_DB_MAIN_DSN=postgres://app_user:change-me@localhost:5432/app_dev
# Optional read-only connection (opened with default_transaction_read_only=on).
# APP_DB_REPORTING_DSN=postgres://app_reader:change-me@localhost:5432/app_dev
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

# JWT (jose, HS256). Generate a random 64+ character secret per environment.
JWT_SECRET=replace-with-a-random-64-char-secret-generated-per-environment-0000
JWT_ISSUER=app-api
JWT_AUDIENCE=app-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=14

# Swagger UI at /docs (always false in production).
DOCS_ENABLED=true
