# cuadrilla — python-fastapi: backend/.env.example (versioned). Copy to backend/.env (NOT versioned)
# and fill in real values locally. Names only + fake values here; never commit a real secret.
# Prefix <APP>_ = Settings.model_config env_prefix (the package name from the profile, uppercased).

<APP>_ENVIRONMENT=development

# One DSN per named connection of the project profile: <APP>_DB_<NAME>_DSN
<APP>_DB_MAIN_DSN=postgresql://app_user:change-me@localhost:5432/app_db
<APP>_DB_STATEMENT_TIMEOUT_MS=5000
<APP>_DB_POOL_MAX_SIZE=10

# JWT signing key: a long random value, different per environment.
<APP>_JWT_SECRET=change-me-to-a-long-random-value
<APP>_JWT_ALGORITHM=HS256
<APP>_ACCESS_TOKEN_MINUTES=15
<APP>_REFRESH_TOKEN_DAYS=7
<APP>_BCRYPT_ROUNDS=12

# JSON list of explicit origins (never "*" in production).
<APP>_CORS_ORIGINS=["http://localhost:5173"]
# OpenAPI/Swagger only outside production.
<APP>_DOCS_ENABLED=true

# Optional, for the read-only postgres MCP server of this pack (a read-only DB role, local DB only).
# Set it in your shell or Claude Code env, not in this file: POSTGRES_MCP_DSN=postgresql://readonly@localhost:5432/app_db
