{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git remote -v)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git rev-parse*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh auth status*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr diff*)",
      "PowerShell(gh pr checks*)",
      "Bash(npx skills find*)",
      "Bash(npx -y skills find*)",
      "mcp__plugin_cuadrilla_github__get_*",
      "mcp__plugin_cuadrilla_github__list_*",
      "mcp__plugin_cuadrilla_github__search_*",
      "mcp__plugin_cuadrilla_github__pull_request_read",
      "mcp__plugin_cuadrilla_github__issue_read",
      "mcp__plugin_cuadrilla_atlassian__get*",
      "mcp__plugin_cuadrilla_atlassian__search*"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr comment*)",
      "Bash(npx skills add*)",
      "Bash(npx skills update*)",
      "PowerShell(Stop-Process*)",
      "mcp__plugin_cuadrilla_github__create_pull_request",
      "mcp__plugin_cuadrilla_github__add_issue_comment",
      "mcp__plugin_cuadrilla_github__add_comment_to_pending_review"
    ],
    "deny": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr review*)",
      "Bash(gh secret*)",
      "Bash(gh api*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh api*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "mcp__plugin_cuadrilla_github__merge_pull_request",
      "mcp__plugin_cuadrilla_github__push_files",
      "mcp__plugin_cuadrilla_github__create_or_update_file",
      "mcp__plugin_cuadrilla_github__delete_file",
      "mcp__plugin_cuadrilla_github__submit_pending_pull_request_review",
      "mcp__plugin_cuadrilla_github__create_and_submit_pull_request_review",
      "mcp__plugin_cuadrilla_github__pull_request_review_write",
      "mcp__plugin_cuadrilla_atlassian__*delete*"
    ]
  }
}
